# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (선택) OG 태그 절대 URL 기준 주소 — 미설정 시 Vercel 프로덕션 URL을 자동 사용
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# (선택) 담당자 배정 메일 알림 — resend.com 에서 무료 API 키 발급
# 키가 없으면 메일 발송만 건너뛰고 나머지는 정상 동작합니다.
RESEND_API_KEY=
# 발신자 주소. 도메인 인증 전에는 기본값(onboarding@resend.dev)만 사용 가능
EMAIL_FROM=업무보드 <onboarding@resend.dev>
